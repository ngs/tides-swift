# frozen_string_literal: true

# An empty env var (an unset Actions secret) must also fall through: '' is
# truthy in Ruby and would otherwise be passed to git verbatim.
custom_git_url = ENV['MATCH_GIT_URL']
git_url(
  custom_git_url.nil? || custom_git_url.empty? ? 'git@github.com:ngs/littleapps-fastlane-certificates.git' : custom_git_url
)
storage_mode('git')

type('appstore')

# The app plus the extensions embedded in it. The widget shares the
# group.io.ngs.Tides App Group with the app, so its profile must carry that
# entitlement - regenerate with MATCH_READONLY=false after changing it.
app_identifier(['io.ngs.Tides', 'io.ngs.Tides.watchkitapp', 'io.ngs.Tides.widget'])

team_id('3Y8APYUG2G')
