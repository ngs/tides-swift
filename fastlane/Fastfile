# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc 'Match App Store Provisioning Profiles'
  lane :release_match do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    # Authenticates match against the Developer Portal without an Apple ID.
    setup_app_store_connect_api_key
    # Includes the embedded watchOS app and the widget extension.
    match type: 'appstore',
          app_identifier: ['io.ngs.Tides', 'io.ngs.Tides.watchkitapp', 'io.ngs.Tides.widget'],
          readonly: ENV['MATCH_READONLY'] == 'true'
  end

  desc 'Build app for release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    # Get the provisioning profile name from match
    profile_name = ENV['sigh_io.ngs.Tides_appstore_profile-name'] || 'match AppStore io.ngs.Tides'
    identifier = 'io.ngs.Tides'

    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: identifier,
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Tides'],
      build_configurations: %w[Release],
      path: 'Tides.xcodeproj'
    )

    # The watch app and the widget embedded in the iOS build need their own profiles
    embedded_targets = {
      'TidesWatch' => 'io.ngs.Tides.watchkitapp',
      'TidesWidget' => 'io.ngs.Tides.widget'
    }
    embedded_targets.each do |target, embedded_identifier|
      embedded_profile_name = ENV["sigh_#{embedded_identifier}_appstore_profile-name"] ||
                              "match AppStore #{embedded_identifier}"
      update_code_signing_settings(
        profile_name: embedded_profile_name,
        bundle_identifier: embedded_identifier,
        use_automatic_signing: false,
        code_sign_identity: 'Apple Distribution',
        targets: [target],
        build_configurations: %w[Release],
        path: 'Tides.xcodeproj'
      )
    end

    # Let gym detect iOS from the destination instead of forcing the SDK.
    require_relative 'patches/gym_module_patch'

    # Build the app and create the archive. No `sdk:`: `xcodebuild -sdk`
    # applies to every target in the build, which compiled the embedded
    # watchOS app against the iOS SDK (wrong architectures, DTPlatformName
    # and UIDeviceFamily). The destination alone picks the right SDK per
    # target.
    build_app(
      export_method: 'app-store',
      scheme: 'Tides',
      destination: 'generic/platform=iOS',
      output_directory: './build/release/ios',
      output_name: 'Tides-iOS'
    )
  end

  desc 'Publish app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    pilot(
      skip_waiting_for_build_processing: true,
      ipa: './build/release/ios/Tides-iOS.ipa'
    )
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key

    deliver(
      platform: 'ios',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      # App Review will not let the app be added for review until the age
      # rating questionnaire is answered. It is an app-level declaration, so
      # whichever platform lane runs sets it for all of them.
      app_rating_config_path: './fastlane/metadata/app_store_rating_config.json',
      app_identifier: 'io.ngs.Tides'
    )
  end

  desc 'Update App Store screenshots'
  desc 'Capture them first with Scripts/screenshots.sh.'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key

    # iPhone, iPad and the Watch all live here: deliver picks the store's
    # display type from each file's pixel size, not from its name, and the watch
    # app is part of the iOS app.
    deliver(
      platform: 'ios',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/ios',
      app_identifier: 'io.ngs.Tides'
    )
  end
end

platform :mac do
  desc 'Create keychain'
  lane :create_ci_keychain do
    create_keychain(
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )
  end

  desc 'Match App Store Provisioning Profiles for macOS'
  lane :release_match do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    setup_app_store_connect_api_key
    # Get Application Distribution certificate and provisioning profiles
    # (the app and the widget extension embedded in it).
    match(
      type: 'appstore',
      app_identifier: ['io.ngs.Tides', 'io.ngs.Tides.widget'],
      platform: 'macos',
      readonly: ENV['MATCH_READONLY'] == 'true'
    )
    # Get Mac Installer Distribution certificate for PKG creation
    match(
      type: 'appstore',
      app_identifier: 'io.ngs.Tides',
      platform: 'macos',
      additional_cert_types: 'mac_installer_distribution',
      readonly: ENV['MATCH_READONLY'] == 'true'
    )
  end

  desc 'Build app for macOS release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    # Get the provisioning profile name from match
    profile_name = ENV['sigh_io.ngs.Tides_appstore_macos_profile-name'] || 'match AppStore io.ngs.Tides macos'

    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: 'io.ngs.Tides',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Tides'],
      build_configurations: %w[Release],
      path: 'Tides.xcodeproj'
    )

    # The widget extension embedded in the macOS app needs its own profile
    widget_profile_name = ENV['sigh_io.ngs.Tides.widget_appstore_macos_profile-name'] ||
                          'match AppStore io.ngs.Tides.widget macos'
    update_code_signing_settings(
      profile_name: widget_profile_name,
      bundle_identifier: 'io.ngs.Tides.widget',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['TidesWidget'],
      build_configurations: %w[Release],
      path: 'Tides.xcodeproj'
    )

    build_app(
      export_method: 'app-store',
      scheme: 'Tides',
      destination: 'generic/platform=macOS',
      output_directory: './build/release/mac',
      output_name: 'Tides-macOS',
      sdk: 'macosx'
    )
  end

  desc 'Publish macOS app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    # Upload macOS app to App Store Connect
    upload_to_app_store(
      app_identifier: 'io.ngs.Tides',
      platform: 'osx',
      pkg: './build/release/mac/Tides-macOS.pkg',
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key

    deliver(
      platform: 'osx',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      # App Review will not let the app be added for review until the age
      # rating questionnaire is answered. It is an app-level declaration, so
      # whichever platform lane runs sets it for all of them.
      app_rating_config_path: './fastlane/metadata/app_store_rating_config.json',
      app_identifier: 'io.ngs.Tides'
    )
  end

  desc 'Update App Store screenshots'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key

    deliver(
      platform: 'osx',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/mac',
      app_identifier: 'io.ngs.Tides'
    )
  end
end

# visionOS uses iOS platform but with different scheme
platform :visionos do
  desc 'Match App Store Provisioning Profiles for visionOS (alias to iOS)'
  lane :release_match do
    # visionOS uses iOS provisioning profiles, so just call the iOS lane
    Fastlane::LaneManager.cruise_lane('ios', 'release_match')
  end

  desc 'Build app for visionOS release'
  lane :release_build do
    xcode_select ENV['XCODE_PATH'] if ENV['XCODE_PATH']
    release_match

    # Get the provisioning profile name from match (visionOS uses iOS profiles)
    profile_name = ENV['sigh_io.ngs.Tides_appstore_profile-name'] || 'match AppStore io.ngs.Tides'

    update_code_signing_settings(
      profile_name: profile_name,
      bundle_identifier: 'io.ngs.Tides',
      use_automatic_signing: false,
      code_sign_identity: 'Apple Distribution',
      targets: ['Tides'],
      build_configurations: %w[Release],
      path: 'Tides.xcodeproj'
    )

    # Load monkey patches
    require_relative 'patches/gym_module_patch'

    build_app(
      export_method: 'app-store',
      scheme: 'Tides',
      destination: 'generic/platform=visionOS',
      output_directory: './build/release/visionos',
      output_name: 'Tides-visionOS',
      sdk: 'xros'
    )
  end

  desc 'Publish visionOS app to App Store'
  lane :release_upload do
    setup_app_store_connect_api_key

    pilot(
      skip_waiting_for_build_processing: true,
      ipa: './build/release/visionos/Tides-visionOS.ipa'
    )
  end

  desc 'Update App Store metadata'
  lane :deliver_metadata do
    setup_app_store_connect_api_key

    deliver(
      platform: 'xros',
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      metadata_path: './fastlane/metadata',
      # App Review will not let the app be added for review until the age
      # rating questionnaire is answered. It is an app-level declaration, so
      # whichever platform lane runs sets it for all of them.
      app_rating_config_path: './fastlane/metadata/app_store_rating_config.json',
      app_identifier: 'io.ngs.Tides'
    )
  end

  desc 'Update App Store screenshots'
  lane :deliver_screenshots do
    setup_app_store_connect_api_key

    # Supported since fastlane 2.230.0, which added the Vision Pro display type
    # (and the 6.9" iPhone / 13" iPad sizes the iOS lane needs). The path has to
    # keep the word "vision" in it: 3840x2160 is also an Apple TV size, and that
    # is how deliver tells them apart.
    deliver(
      platform: 'xros',
      force: true,
      skip_metadata: true,
      skip_binary_upload: true,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
      screenshots_path: './fastlane/screenshots/visionos',
      app_identifier: 'io.ngs.Tides'
    )
  end
end

desc 'Create the App IDs for the embedded targets in the Developer Portal'
desc 'Only needed once; match refuses to issue a profile for an unknown bundle ID.'
lane :register_bundle_ids do
  api_key = setup_app_store_connect_api_key
  UI.user_error!('App Store Connect API key is required') if api_key.nil?

  {
    'io.ngs.Tides.watchkitapp' => 'Tides Watch App',
    'io.ngs.Tides.widget' => 'Tides Widget'
  }.each do |identifier, name|
    existing = Spaceship::ConnectAPI::BundleId.find(identifier)
    if existing
      UI.success("#{identifier} already registered")
      next
    end
    Spaceship::ConnectAPI::BundleId.create(
      name: name,
      identifier: identifier,
      platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS
    )
    UI.success("Registered #{identifier}")
  end
end

desc 'Declare that the app uses third-party content, and that we hold the rights'
desc 'The tide data derives from the FES model, an AVISO+ Product whose IP belongs to'
desc 'CNES/CTOH; the licence grants commercial distribution of derived products.'
desc 'See ngs/tides-api DATA_LICENSING.md.'
lane :declare_content_rights do
  api_key = setup_app_store_connect_api_key
  UI.user_error!('App Store Connect API key is required') if api_key.nil?

  # deliver only sets this on the way into a review submission — which is
  # exactly what the missing declaration blocks — so set it directly.
  app = Spaceship::ConnectAPI::App.find('io.ngs.Tides')
  UI.user_error!('io.ngs.Tides was not found on App Store Connect') if app.nil?

  app.update(attributes: {
               contentRightsDeclaration: Spaceship::ConnectAPI::App::ContentRightsDeclaration::USES_THIRD_PARTY_CONTENT
             })
  UI.success('Content rights: uses third-party content')
end

desc 'Upload the App Privacy declarations from fastlane/app_privacy_details.json'
desc 'Needs an Apple ID, not the API key: the action calls Spaceship::ConnectAPI.login,'
desc 'which opens a web session and replaces the token-backed client. Run it locally,'
desc 'where the 2FA prompt can be answered — it will not work unattended in CI.'
lane :upload_privacy_details do
  # A note on the JSON, because it reads like something is missing and it is not.
  # There are exactly four data protections: DATA_USED_TO_TRACK_YOU,
  # DATA_LINKED_TO_YOU, DATA_NOT_LINKED_TO_YOU and DATA_NOT_COLLECTED. "Not used
  # for tracking" has no positive value — it is expressed by the *absence* of
  # DATA_USED_TO_TRACK_YOU, which is how the action's own generator encodes it:
  #
  #     tracking_id = is_used_for_tracking ? DATA_USED_TO_TRACK_YOU : nil
  #     "data_protections" => [protection_id, tracking_id].compact
  #
  # Inventing a "DATA_NOT_USED_FOR_TRACKING" would not merely be ignored. Upload
  # deletes every existing declaration first, then POSTs one AppDataUsage per
  # data protection — so an unknown id fails *after* the wipe, leaving App
  # Privacy blank on App Store Connect.
  upload_app_privacy_details_to_app_store(
    app_identifier: 'io.ngs.Tides',
    json_path: './fastlane/app_privacy_details.json',
    skip_json_file_saving: true
  )
end

desc 'Setup AppStore Connect API Key'
lane :setup_app_store_connect_api_key do
  return unless ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'] && ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'] && ENV['APP_STORE_CONNECT_API_KEY_KEY']

  app_store_connect_api_key(
    key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
    key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
    is_key_content_base64: ENV['APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64'] == 'true'
  )
end

desc 'Create keychain'
lane :create_ci_keychain do
  create_keychain(
    default_keychain: true,
    unlock: true,
    timeout: 3600
  )
end
