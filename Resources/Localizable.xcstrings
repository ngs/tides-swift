{
  "sourceLanguage": "en",
  "strings": {
    "Add Location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地点を追加"
          }
        }
      }
    },
    "Add a location from the iPhone app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneアプリから地点を追加してください。"
          }
        }
      }
    },
    "Add a location from the map to see tide predictions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップから地点を追加すると潮汐予測を表示できます。"
          }
        }
      }
    },
