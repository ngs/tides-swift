{
  "sourceLanguage": "en",
  "strings": {
    "%@ and its offline tide data will be removed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とオフライン潮汐データを削除します。"
          }
        }
      }
    },
    "Add Location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地点を追加"
          }
        }
      }
    },
    "Add a location from the iPhone app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneアプリから地点を追加してください。"
          }
        }
      }
    },
    "Add a location from the map to see tide predictions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップから地点を追加すると潮汐予測を表示できます。"
          }
        }
      }
    },
    "Available Offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで利用可能"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose a saved location, or add one from the map.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの地点を選択するか、マップから追加してください。"
          }
        }
      }
    },
    "Choose which saved location the widget shows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットに表示する保存済みの地点を選びます。"
          }
        }
      }
    },
    "Clear Search": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索をクリア"
          }
        }
      }
    },
    "Coordinates": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座標"
          }
        }
      }
    },
    "Current Tide": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の潮位"
          }
        }
      }
    },
    "Current tide and next high and low water for a saved location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した地点の現在の潮位と次の満潮・干潮を表示します。"
          }
        }
      }
    },
    "Date": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Delete Location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地点を削除"
          }
        }
      }
    },
    "Edit Location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地点を編集"
          }
        }
      }
    },
    "Enter a latitude between -90 and 90 and a longitude between -180 and 180.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度は -90〜90、経度は -180〜180 の範囲で入力してください。"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー"
          }
        }
      }
    },
