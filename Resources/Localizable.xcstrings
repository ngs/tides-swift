      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した地点"
          }
        }
      }
    },
    "Tap the map to move this location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップをタップすると地点を移動できます。"
          }
        }
      }
    },
    "Tap the map to select a location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップをタップして地点を選択してください。"
          }
        }
      }
    },
    "The saved parameters for this location could not be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地点の保存済みパラメータを読み込めませんでした。"
          }
        }
      }
    },
    "The server returned an invalid response.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから不正な応答が返されました。"
          }
        }
