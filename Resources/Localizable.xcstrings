    "New tide parameters will be downloaded for the new coordinates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい座標の潮汐パラメータをダウンロードします。"
          }
        }
      }
    },
    "Next Day": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翌日"
          }
        }
      }
    },
