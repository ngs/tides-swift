          "stringUnit": {
            "state": "translated",
            "value": "地点や住所で検索"
          }
        }
      }
    },
    "Search for a place, or tap the map to select a location.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地点を検索するか、マップをタップして場所を選択してください。"
